# 환경변수 이름표. 값은 여기 적지 않는다 — 이 파일은 저장소에 올라간다.
# 실제 값은 옆에 .env 를 만들어 넣거나 셸에서 직접 지정한다(.env 는 gitignore).
# 서버가 뜰 때 이 폴더의 .env 를 읽는다. 이미 환경변수에 있는 이름은 안 덮는다.
#
# 애드로그 OpenAPI 키. 없으면 순위 조회만 건너뛰고 나머지 수집은 계속한다.
ADLOG_API_KEY=

# 애드로그 회원 아이디. 모든 요청 본문에 user_id 로 들어간다.
# 키만 있고 이게 없으면 애드로그가 4000 으로 되돌린다.
ADLOG_USER_ID=

# 캡처·PDF 판독에 쓰는 앤트로픽 키. 없으면 자료 넣기 칸만 잠기고 나머지는 돈다.
ANTHROPIC_API_KEY=

# 견적서 하단 계좌 줄. 없으면 그 줄이 통째로 빠진다.
CMO_BANK_ACCOUNT=
